{
  "name": "claude-chess-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "predev:host": "npm run prepare-assets",
    "dev:host": "vite --host",
    "prebuild": "npm run prepare-assets",
    "build": "tsc --noEmit && vite build",
    "copy-engine": "node scripts/copy-engine.mjs",
    "fetch-famous": "node scripts/fetch-famous-games.mjs",
    "fetch-modern": "node scripts/fetch-modern-championships.mjs",
    "fetch-federations": "node scripts/fetch-federations.mjs",
    "build-library": "node scripts/build-library.mjs && node scripts/fetch-federations.mjs",
    "audit-library": "node scripts/audit-library.mjs",
    "audit-pgn": "node --max-old-space-size=4096 scripts/audit-pgn-archive.mjs",
    "dedupe-pgn": "node --max-old-space-size=4096 scripts/dedupe-pgn-archive.mjs",
    "fetch-careers": "node scripts/fetch-careers.mjs",
    "screens": "node scripts/phone-screens.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "depcruise": "depcruise --config .dependency-cruiser.mjs src",
    "verify": "npm run typecheck && npm test && npm audit --audit-level=moderate",
    "layout-check": "node scripts/layout-check.mjs",
    "behaviour-check": "node scripts/behaviour-check.mjs",
    "offline-check": "node scripts/offline-check.mjs",
    "a11y-check": "node scripts/a11y-check.mjs",
    "paths-check": "node scripts/paths-check.mjs"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "chess.js": "^1.4.0",
    "react": "^19.3.1",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.1",
    "stockfish": "^19.0.1"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^18.7.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.2"
  }
}
