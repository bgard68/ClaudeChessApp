bin/
obj/
node_modules/
dist/
.vs/
.vscode/
*.user

# Copied from node_modules by scripts/copy-engine.mjs
public/engine/

# The raw downloads, and the career archives that run to a hundred megabytes.
# The cleaned collections in public/games/ ARE committed — they are two
# megabytes, and committing them is what stops every clone, every dev start and
# every deploy from depending on a third party staying up and unchanged.
public/games/raw/

# Exported PGN copies for local use — never committed
/library/

# The consolidated PGN archive. Every collection in one place, kept outside the
# worktrees so it survives them — around 100 MB of re-downloadable game scores,
# which is not something to put in a history that cannot forget. See pgn/MANIFEST.txt.
# Anchored to the root: unanchored, this also swallowed src/infrastructure/pgn/.
/pgn/

# Untouched copies of the generated collections, kept at their original paths.
/original/

# Vite cache
.vite/

# Local environment and machine-local config — never committed.
# See CLAUDE.md: no secrets in the repository.
.env*
*.local

# ---------- Remote-repository hygiene ----------

# Logs of any kind
logs/
*.log
npm-debug.log*

# Test and tooling output
coverage/
playwright-report/
test-results/
phone-screens/
*.tsbuildinfo

# OS and editor debris
Thumbs.db
.DS_Store
.idea/

# Claude Code session data — worktrees, transcripts, local tool config.
# Nothing under it belongs in the repository.
.claude/

# Azure credentials, publish profiles, and import/export artefacts
.azure/
*.publishsettings
*.PublishSettings
local.settings.json
appsettings.*.json
*.bacpac
*.dacpac

# Key material of any kind
*.pem
*.key
*.pfx
*.p12

# Conversation exports and transcripts
conversations/
transcripts/

# The gate's throwaway failing-test probe; deleted by the script, ignored in
# case a crash strands it.
**/gate-probe.test.ts
